# Copy to .env.local
AUTH_SECRET=change-me-to-a-long-random-string
DATA_KEY=change-me-too-(used-to-encrypt-bank-account-numbers)
# Database file (SQLite). Defaults to ./data/geniq.db
DATABASE_PATH=./data/geniq.db
# Demo one-time code used for MFA / OTP screens until an SMS/Email gateway is integrated
DEMO_OTP=246810

# Server-side only. Obtain a key from your SerpApi account.
SERPAPI_API_KEY=
# Employee Assistant travel planning reuses this server-side key.
# Search results and provider links do not issue tickets or reserve hotel rooms.
# No transactional flight/hotel provider is configured in this application.
